# UBIC1-v0.2 on Sepolia ONLY. Copy to .env.sepolia-v02 (gitignored).
# Keep completely separate from old v0.1 .env and mainnet credentials.
UBIC1_V02_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# A dedicated test-only deployer, not a wallet holding valuable assets.
# Format: 0x followed by exactly 64 hex digits. NEVER commit this value.
UBIC1_V02_SEPOLIA_PRIVATE_KEY=
# Hard limit for the maximum EIP-1559 deploy transaction fee (test ETH).
UBIC1_V02_SEPOLIA_MAX_FEE_ETH=0.02
