# Generic Ethereum deployment configuration for Sepolia. Copy to .env.sepolia.
# Never reuse an address or private key that holds valuable assets.
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=
# Maximum EIP-1559 deployment fee (test ETH); rejects larger fees.
MAX_DEPLOY_FEE_ETH=0.02
