{
  "name": "daycoin-mainnet",
  "account_id": "7cd361e713a3e8c115f613ec88a5707f",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./worker.mjs",
  "analytics_engine_datasets": [{ "binding": "JOURNEY", "dataset": "daycoin_journey" }],
  "d1_databases": [{ "binding": "JOURNEY_DB", "database_name": "talka-journey", "database_id": "2bd18c7b-93c4-40c4-b653-8e7e2d074050" }],
  "routes": [{ "pattern": "daycoin.io99.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/journey"]
  }
}
